# 不要提交真实凭据；本服务仅从环境变量读取它们。
ARCHERY_BASE_URL=https://archery.example.com
ARCHERY_USERNAME=your_archery_username
ARCHERY_PASSWORD=your_archery_password

# 若账号开启 Google 身份验证器，填写 base32 TOTP Secret；未开启则留空。
ARCHERY_TOTP_SECRET=

# 服务端固定查询目标，调用 MCP 工具时不能切换。
# 实例名、数据库名以你的 Archery 平台中的配置为准；
# PostgreSQL 通常填写 ARCHERY_SCHEMA_NAME=public，MySQL 可留空。
ARCHERY_INSTANCE_NAME=prod-app-db
ARCHERY_DB_NAME=app_db
ARCHERY_SCHEMA_NAME=public

# 查询工具未传 limit 时使用的默认值；0 表示由 Archery 按账号权限使用最大限制。
# 实际 SQL 校验、最大行数、超时和数据脱敏均由 Archery 负责。
ARCHERY_QUERY_LIMIT=100
